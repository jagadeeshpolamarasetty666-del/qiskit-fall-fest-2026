    "# 1. Create a 2-qubit, 2-classical-bit circuit\n",
    "qc_orig = QuantumCircuit(2, 2)\n",
    "\n",
    "# 2. Construct the standard Bell-state: H on q0, CNOT with control q0 and target q1\n",
    "qc_orig.h(0)\n",
    "qc_orig.cx(0, 1)\n",
    "\n",
    "# 3. Measure both qubits\n",
    "qc_orig.measure([0, 1], [0, 1])\n",
    "\n",
    "# 4. Draw circuit\n",
    "print(\"Original Bell-State Circuit (|Phi+>):\")\n",
    "display(qc_orig.draw('mpl'))\n",
    "\n",
    "# 5. Run simulation for 100 shots\n",
    "job_orig = simulator.run(qc_orig, shots=SHOTS)\n",
    "counts_orig = job_orig.result().get_counts()\n",
    "print(f\"Original Circuit Counts (100 shots): {counts_orig}\")\n",
    "\n",
    "# 6. Plot histogram\n",
    "display(plot_histogram(counts_orig, title=\"Original Bell State: |Phi+> (100 shots)\"))"
   ]
  },
