    "# 1. Create a 2-qubit, 2-classical-bit circuit\n",
    "qc_mod = QuantumCircuit(2, 2)\n",
    "\n",
    "# 2. Bell-state foundation\n",
    "qc_mod.h(0)\n",
    "qc_mod.cx(0, 1)\n",
    "\n",
    "# 3. Add exactly ONE quantum gate: X gate on q1 to flip the correlation\n",
    "qc_mod.x(1)\n",
    "\n",
    "# 4. Measure both qubits\n",
    "qc_mod.measure([0, 1], [0, 1])\n",
    "\n",
    "# 5. Draw circuit\n",
    "print(\"Modified Bell-State Circuit (|Psi+>):\")\n",
    "display(qc_mod.draw('mpl'))\n",
    "\n",
    "# 6. Run simulation for 100 shots\n",
    "job_mod = simulator.run(qc_mod, shots=SHOTS)\n",
    "counts_mod = job_mod.result().get_counts()\n",
    "print(f\"Modified Circuit Counts (100 shots): {counts_mod}\")\n",
    "\n",
    "# 7. Plot histogram\n",
    "display(plot_histogram(counts_mod, title=\"Modified Circuit: |Psi+> (100 shots)\"))"
   ]
  },
